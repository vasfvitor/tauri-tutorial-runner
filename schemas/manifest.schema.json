{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "description": "bumped when the manifest shape changes; consumers assert on it",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "advisory": {
      "description": "true when produced outside the pinned container (`tatu check`)",
      "type": "boolean"
    },
    "platform": {
      "description": "node-compatible platform tag: win32 / darwin / linux",
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StepRecord"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "advisory",
    "platform",
    "steps"
  ],
  "$defs": {
    "StepRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "mutations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MutationRecord"
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResultRecord"
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResultRecord"
          }
        }
      },
      "required": [
        "id",
        "task",
        "mutations",
        "preconditions",
        "assertions"
      ]
    },
    "MutationRecord": {
      "type": "object",
      "properties": {
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "diff": {
          "description": "base-relative unified diff; empty string when the overlay changed nothing",
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ResultRecord": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/Status"
        }
      },
      "required": [
        "kind",
        "status"
      ]
    },
    "Status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "skipped"
      ]
    }
  }
}
