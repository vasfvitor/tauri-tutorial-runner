{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tutorial",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "meta": true,
    "base": {
      "$ref": "#/$defs/Base"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Step"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "base",
    "steps"
  ],
  "$defs": {
    "Base": {
      "type": "object",
      "properties": {
        "fixture": {
          "description": "vendored scaffold dir, relative to the tutorial dir (usually a `bases/`\npool entry; `tatu revendor` re-scaffolds those)",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "fixture"
      ]
    },
    "Step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "task": {
          "description": "natural-language instruction — doubles as the agent-eval prompt",
          "type": "string"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assertion"
          }
        },
        "mutations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mutation"
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assertion"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "task"
      ]
    },
    "Assertion": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/AssertionKind"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": true,
        "expect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expect"
            },
            {
              "type": "null"
            }
          ]
        },
        "setup": {
          "description": "verbatim Rust inserted before the invoke in the generated test",
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "AssertionKind": {
      "type": "string",
      "enum": [
        "ipc-local",
        "ipc-acl",
        "shell"
      ]
    },
    "Expect": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExpectKeyword"
        },
        {
          "type": "object",
          "properties": {
            "ok": true
          },
          "required": [
            "ok"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ok_contains": {
              "type": "string"
            }
          },
          "required": [
            "ok_contains"
          ]
        },
        {
          "description": "the command must fail with an error carrying this substring — for\nfailures that are not ACL denials (a plugin scope refusal, say)",
          "type": "object",
          "properties": {
            "err_contains": {
              "type": "string"
            }
          },
          "required": [
            "err_contains"
          ]
        }
      ]
    },
    "ExpectKeyword": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "denied"
          ]
        },
        {
          "description": "the command must succeed but its value is not compared — for commands\nreturning a resource id, which is random by design",
          "type": "string",
          "const": "succeeds"
        }
      ]
    },
    "Mutation": {
      "oneOf": [
        {
          "description": "copy steps/<step-id>/** over the work tree",
          "type": "object",
          "properties": {
            "engine": {
              "type": "string",
              "const": "overlay"
            }
          },
          "required": [
            "engine"
          ]
        },
        {
          "description": "deep-merge into a JSON file (objects recurse, arrays union)",
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "merge": true,
            "engine": {
              "type": "string",
              "const": "json-merge"
            }
          },
          "required": [
            "engine",
            "file",
            "merge"
          ]
        },
        {
          "description": "run a command in the work tree",
          "type": "object",
          "properties": {
            "run": {
              "type": "string"
            },
            "cwd": {
              "type": [
                "string",
                "null"
              ]
            },
            "engine": {
              "type": "string",
              "const": "shell"
            }
          },
          "required": [
            "engine",
            "run"
          ]
        }
      ]
    }
  }
}
